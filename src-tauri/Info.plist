<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>LSUIElement</key>
    <true/>
    <key>NSScreenCaptureUsageDescription</key>
    <string>Reattend reads your screen to passively capture and remember important information like meeting notes, decisions, and action items.</string>
    <key>NSAccessibilityUsageDescription</key>
    <string>Reattend uses accessibility features to detect active applications and save selected text.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Reattend records meeting audio to transcribe and save as memories with action items and decisions.</string>
    <key>NSServices</key>
    <array>
        <dict>
            <key>NSMenuItem</key>
            <dict>
                <key>default</key>
                <string>Save to Reattend</string>
            </dict>
            <key>NSMessage</key>
            <string>saveToReattend</string>
            <key>NSPortName</key>
            <string>Reattend</string>
            <key>NSSendTypes</key>
            <array>
                <string>NSStringPboardType</string>
                <string>public.utf8-plain-text</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
