{
  "$schema": "https://raw.githubusercontent.com/nicedoc/tauri/tauri-v2/packages/cli/schema.json",
  "productName": "Reattend",
  "version": "0.1.13",
  "identifier": "com.reattend.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "node scripts/prebuild.cjs"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "Developer ID Application: Partha Borthakur (6AKUD88CVN)",
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "category": "public.app-category.productivity",
    "resources": [
      "swift-plugin/.build/release/reattend-capture"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "reattend"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgwRkZFQzEwMUM3MTYzMjMKUldRalkzRWNFT3ovZ1ArbVZoM3oxNFNQU3Z1dk92ZjdjTmFjZEhGcWVkUnUvbVNoQzhXeDhjdUMK",
      "endpoints": [
        "https://www.reattend.com/api/updater/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  }
}
